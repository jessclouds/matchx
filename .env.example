# Copy this file to .env and fill in your real values. .env is gitignored.

# From @BotFather → /newbot (or /token for an existing bot)
BOT_TOKEN=123456:your-token-from-BotFather

# Your bot's username, used to build ?start=<event_code> deep links.
# With or without the leading @.
BOT_USERNAME=@YourBotUsername

# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled "Session" connection string and your real password.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Optional
LOG_LEVEL=INFO
PERSISTENCE_FILE=bot_state.pickle
